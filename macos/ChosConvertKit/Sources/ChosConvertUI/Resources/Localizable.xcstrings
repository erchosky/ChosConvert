    "access.prompt.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChosConvert needs your permission to save files in “%@”. Click Allow to confirm this folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ChosConvert necesita tu permiso para guardar archivos en «%@». Pulsa Permitir para confirmar esta carpeta."
          }
        }
      }
    },
